#include <iostream>
using namespace std;

int main() {

    int numbers[4] = {40, 12, 30, 16};
    int temp;

    // Sorting the array
    for(int i = 0; i < 4; i++) {

        for(int j = i + 1; j < 4; j++) {

            if(numbers[i] > numbers[j]) {

                temp = numbers[i];
                numbers[i] = numbers[j];
                numbers[j] = temp;
            }
        }
    }

    // Display sorted array
    cout << "Numbers after sorting:" << endl;

    for(int i = 0; i < 4; i++) {
        cout << numbers[i] << " ";
    }

    return 0;
}
